                    <span
                        class="w-7 h-7 rounded-lg flex items-center justify-center flex-shrink-0 transition-colors text-base"
                        :class="activeCategory === '{{ $category->id }}' ? 'bg-white/20' : 'bg-slate-100'">
                        {{ $category->icon ?? '📦' }}
                    </span>
                    <span class="flex-1 truncate">{{ $category->name }}</span>
                    <span
                        class="text-[10px] font-semibold px-1.5 py-0.5 rounded-md"
                        :class="activeCategory === '{{ $category->id }}' ? 'bg-white/25 text-white' : 'bg-slate-100 text-slate-500'">
                        {{ $category->products->count() }}
                    </span>
                </button>
                @endforeach
            </nav>

            {{-- Sidebar Footer --}}
            <div class="px-4 py-4 border-t border-slate-100 space-y-1">
                <p class="text-[10px] text-slate-400 text-center font-mono">
                    {{ now()->format('D, d M Y') }}
                </p>
                <p class="text-[10px] text-slate-400 text-center font-mono" x-text="currentTime"></p>
            </div>
        </aside>

        {{-- ===============================================================
         CENTER: PRODUCT GRID
    =============================================================== --}}
        <main class="flex-1 flex flex-col min-w-0 overflow-hidden">

            {{-- Top Bar --}}
            <header class="bg-white/80 backdrop-blur-sm border-b border-slate-100 px-6 py-4 flex items-center gap-4 flex-shrink-0">

                {{-- Search --}}
                <div class="relative flex-1 max-w-md">
                    <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    <input
                        type="text"
                        x-model="searchQuery"
                        @input="filterProducts"
                        placeholder="Search products, SKU…"
                        class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-200 focus:border-brand-400 transition-all" />
                    <button
                        x-show="searchQuery"
                        @click="searchQuery = ''; filterProducts()"
                        class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 transition-colors">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>

                {{-- Active Category Pill --}}
                <div class="flex items-center gap-2">
                    <span class="text-xs text-slate-400 font-medium">Showing:</span>
                    <span x-text="activeCategoryName" class="text-xs font-semibold bg-brand-50 text-brand-700 px-3 py-1.5 rounded-lg"></span>
                </div>

                {{-- Product count --}}
                <div class="ml-auto text-sm text-slate-400">
                    <span class="font-semibold text-slate-600" x-text="filteredProducts.length"></span> items
                </div>

                {{-- View toggle --}}
                <div class="flex items-center bg-slate-100 rounded-lg p-0.5 gap-0.5">
                    <button
                        @click="gridView = true"
                        :class="gridView ? 'bg-white text-brand-600 shadow-card' : 'text-slate-400 hover:text-slate-600'"
                        class="p-1.5 rounded-md transition-all">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                        </svg>
                    </button>
                    <button
                        @click="gridView = false"
                        :class="!gridView ? 'bg-white text-brand-600 shadow-card' : 'text-slate-400 hover:text-slate-600'"
                        class="p-1.5 rounded-md transition-all">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
                        </svg>
                    </button>
                </div>
            </header>

            {{-- Product Grid Area --}}
            <div class="flex-1 overflow-y-auto styled-scroll p-5">

                {{-- Loading state --}}
                <div x-show="isLoading" class="flex flex-col items-center justify-center h-full gap-3 text-slate-400">
                    <svg class="spin w-8 h-8 text-brand-400" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                    </svg>
                    <p class="text-sm font-medium">Loading products…</p>
                </div>

                {{-- Empty state --}}
                <div x-show="!isLoading && filteredProducts.length === 0" class="flex flex-col items-center justify-center h-full gap-3 text-slate-400">
                    <div class="w-16 h-16 rounded-2xl bg-slate-100 flex items-center justify-center">
                        <svg class="w-8 h-8 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                    </div>
                    <p class="text-sm font-semibold text-slate-500">No products found</p>
                    <p class="text-xs text-slate-400">Try a different category or search term</p>
                    <button @click="searchQuery = ''; filterProducts()" class="text-xs text-brand-600 hover:text-brand-800 font-semibold underline underline-offset-2 mt-1">
                        Clear search
                    </button>
                </div>

                {{-- GRID VIEW --}}
                <div
                    x-show="!isLoading && filteredProducts.length > 0 && gridView"
                    class="grid gap-3"
                    style="grid-template-columns: repeat(auto-fill, minmax(155px, 1fr))">
                    <template x-for="product in filteredProducts" :key="product.id">
                        <div
                            @click="addToCart(product)"
                            class="product-card bg-white rounded-2xl shadow-card hover:shadow-card-hover cursor-pointer select-none group animate-fade-in"
                            :class="{ 'ring-2 ring-brand-400 ring-offset-1': isInCart(product.id) }">
                            {{-- Product Image / Placeholder --}}
                            <div class="relative h-28 bg-gradient-to-br from-slate-50 to-brand-50 rounded-t-2xl overflow-hidden flex items-center justify-center">
                                <template x-if="product.image">
                                    <img :src="product.image" :alt="product.name" class="w-full h-full object-cover" />
                                </template>
                                <template x-if="!product.image">
                                    <div class="flex flex-col items-center justify-center gap-1 text-brand-300">
                                        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                                        </svg>
                                    </div>
                                </template>

                                {{-- Cart badge --}}
                                <div
                                    x-show="isInCart(product.id)"
                                    class="absolute top-2 right-2 w-6 h-6 bg-brand-600 rounded-full flex items-center justify-center">
                                    <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                                    </svg>
                                </div>

                                {{-- Add overlay --}}
                                <div class="absolute inset-0 bg-brand-600/0 group-hover:bg-brand-600/8 transition-all duration-200 flex items-center justify-center">
                                    <div class="opacity-0 group-hover:opacity-100 transition-all duration-200 transform translate-y-1 group-hover:translate-y-0">
                                        <div class="bg-white rounded-xl px-2.5 py-1 shadow-lg flex items-center gap-1 text-brand-600">
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 4v16m8-8H4" />
                                            </svg>
                                            <span class="text-[10px] font-bold">Add</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            {{-- Product Info --}}
                            <div class="p-3">
                                <p class="text-xs font-semibold text-slate-800 leading-snug line-clamp-2 mb-1.5 group-hover:text-brand-700 transition-colors" x-text="product.name"></p>
                                <div class="flex items-center justify-between">
                                    <span class="price-tag text-sm font-bold text-brand-600" x-text="'$' + parseFloat(product.price).toFixed(2)"></span>
                                    <span x-show="product.sku" class="text-[9px] text-slate-400 font-mono bg-slate-50 px-1.5 py-0.5 rounded-md" x-text="product.sku"></span>
                                </div>
                            </div>
                        </div>
                    </template>
                </div>

                {{-- LIST VIEW --}}
                <div
                    x-show="!isLoading && filteredProducts.length > 0 && !gridView"
                    class="space-y-2">
                    <template x-for="product in filteredProducts" :key="product.id">
                        <div
                            @click="addToCart(product)"
                            class="product-card bg-white rounded-xl shadow-card hover:shadow-card-hover cursor-pointer select-none group flex items-center gap-4 px-4 py-3"
                            :class="{ 'ring-2 ring-brand-400 ring-offset-1': isInCart(product.id) }">
                            {{-- Thumbnail --}}
                            <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-brand-50 to-slate-50 flex-shrink-0 flex items-center justify-center overflow-hidden">
                                <template x-if="product.image">
                                    <img :src="product.image" :alt="product.name" class="w-full h-full object-cover" />
                                </template>
                                <template x-if="!product.image">
                                    <svg class="w-5 h-5 text-brand-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                                    </svg>
                                </template>
                            </div>

                            {{-- Info --}}
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-semibold text-slate-700 group-hover:text-brand-700 transition-colors truncate" x-text="product.name"></p>
                                <p x-show="product.sku" class="text-[10px] text-slate-400 font-mono" x-text="'SKU: ' + product.sku"></p>
                            </div>

                            {{-- Price + Add --}}
                            <div class="flex items-center gap-4 flex-shrink-0">
                                <span class="price-tag font-bold text-brand-600" x-text="'$' + parseFloat(product.price).toFixed(2)"></span>
                                <div
                                    class="w-8 h-8 rounded-lg flex items-center justify-center transition-all"
                                    :class="isInCart(product.id) ? 'bg-brand-600 text-white' : 'bg-brand-50 text-brand-600 group-hover:bg-brand-600 group-hover:text-white'">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
                                    </svg>
                                </div>
                            </div>
                        </div>
                    </template>
                </div>
            </div>
        </main>

        {{-- ===============================================================
         RIGHT: CART PANEL
    =============================================================== --}}
        <aside class="w-[320px] flex-shrink-0 bg-white shadow-cart flex flex-col z-10 border-l border-slate-100">

            {{-- Cart Header --}}
            <div class="px-5 py-4 border-b border-slate-100 flex items-center gap-3">
                <div class="flex-1">
                    <h2 class="font-bold text-slate-800 text-base leading-none">Order Cart</h2>
                    <p class="text-xs text-slate-400 mt-0.5" x-text="cartItems.length + ' item type' + (cartItems.length !== 1 ? 's' : '')"></p>
                </div>

                {{-- Cart item count badge --}}
                <div
                    class="relative"
                    x-show="totalQty > 0">
                    <div class="w-8 h-8 rounded-xl bg-brand-100 flex items-center justify-center">
                        <svg class="w-4 h-4 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                        </svg>
                    </div>
                    <span
                        class="absolute -top-1 -right-1 w-4 h-4 bg-brand-600 rounded-full text-[9px] text-white font-bold flex items-center justify-center"
                        x-text="totalQty"></span>
                </div>

                {{-- Clear cart --}}
                <button
                    x-show="cartItems.length > 0"
                    @click="clearCart()"
                    class="text-xs text-slate-400 hover:text-red-500 transition-colors font-medium px-2 py-1 hover:bg-red-50 rounded-lg"
                    title="Clear cart">
                    Clear
                </button>
            </div>

            {{-- Cart Items --}}
            <div class="flex-1 overflow-y-auto styled-scroll">

                {{-- Empty cart --}}
                <div
                    x-show="cartItems.length === 0"
                    class="flex flex-col items-center justify-center h-full gap-4 px-6 text-center">
                    <div class="w-20 h-20 rounded-2xl bg-slate-50 flex items-center justify-center">
                        <svg class="w-10 h-10 text-slate-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                        </svg>
                    </div>
                    <div>
                        <p class="font-semibold text-slate-400 text-sm">Cart is empty</p>
                        <p class="text-xs text-slate-300 mt-0.5">Click products to add them</p>
                    </div>
                </div>

                {{-- Cart items list --}}
                <div x-show="cartItems.length > 0" class="divide-y divide-slate-50">
                    <template x-for="item in cartItems" :key="item.id">
                        <div class="px-4 py-3.5 flex gap-3 animate-slide-in-right hover:bg-slate-50/50 transition-colors group">

                            {{-- Product color dot / thumbnail --}}
                            <div class="w-10 h-10 rounded-xl bg-brand-50 flex-shrink-0 flex items-center justify-center overflow-hidden">
                                <template x-if="item.image">
                                    <img :src="item.image" :alt="item.name" class="w-full h-full object-cover rounded-xl" />
                                </template>
                                <template x-if="!item.image">
                                    <span class="text-brand-400 font-bold text-sm" x-text="item.name.charAt(0).toUpperCase()"></span>
                                </template>
                            </div>

                            {{-- Item info + controls --}}
                            <div class="flex-1 min-w-0">
                                <div class="flex items-start justify-between gap-1 mb-2">
                                    <p class="text-xs font-semibold text-slate-700 leading-snug line-clamp-2" x-text="item.name"></p>
                                    <button
                                        @click.stop="removeFromCart(item.id)"
                                        class="opacity-0 group-hover:opacity-100 transition-opacity flex-shrink-0 w-5 h-5 rounded-md hover:bg-red-50 hover:text-red-500 text-slate-300 flex items-center justify-center ml-1">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
                                        </svg>
                                    </button>
                                </div>

                                {{-- Quantity controls + subtotal --}}
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center gap-1 bg-slate-100 rounded-xl p-0.5">
                                        <button
                                            @click.stop="updateQty(item.id, 'decrement')"
                                            class="qty-btn w-6 h-6 rounded-lg bg-white text-slate-600 flex items-center justify-center text-sm font-bold shadow-sm">
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M20 12H4" />
                                            </svg>
                                        </button>
                                        <span class="w-7 text-center text-xs font-bold text-slate-700 font-mono" x-text="item.qty"></span>
                                        <button
                                            @click.stop="updateQty(item.id, 'increment')"
                                            class="qty-btn w-6 h-6 rounded-lg bg-white text-slate-600 flex items-center justify-center shadow-sm">
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
                                            </svg>
                                        </button>
                                    </div>

                                    <span class="price-tag text-sm font-bold text-brand-700" x-text="'$' + (item.price * item.qty).toFixed(2)"></span>
                                </div>
                            </div>
                        </div>
                    </template>
                </div>
            </div>

            {{-- Order Summary & Checkout --}}
            <div class="border-t border-slate-100 bg-white">

                {{-- Discount / Note row --}}
                <div x-show="cartItems.length > 0" class="px-5 pt-4 pb-2">
                    <button
                        @click="showDiscount = !showDiscount"
                        class="text-xs text-brand-600 hover:text-brand-800 font-semibold flex items-center gap-1 transition-colors">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                        </svg>
                        Add discount / note
                    </button>

                    <div x-show="showDiscount" x-transition class="mt-2 space-y-2">
                        <div class="flex gap-2">
                            <input
                                type="number"
                                x-model="discountPercent"
                                placeholder="Discount %"
                                min="0" max="100"
                                class="flex-1 text-xs px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-200 focus:border-brand-400" />
                            <input
                                type="text"
                                x-model="orderNote"
                                placeholder="Note…"
                                class="flex-1 text-xs px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-200 focus:border-brand-400" />
                        </div>
                    </div>
                </div>

                {{-- Totals --}}
                <div x-show="cartItems.length > 0" class="px-5 py-3 space-y-1.5">
                    <div class="flex justify-between text-sm text-slate-500">
                        <span>Subtotal</span>
                        <span class="price-tag font-medium text-slate-700" x-text="'$' + cartSubtotal.toFixed(2)"></span>
                    </div>
                    <div x-show="discountAmount > 0" class="flex justify-between text-sm text-emerald-600">
                        <span x-text="'Discount (' + discountPercent + '%)'"></span>
                        <span class="price-tag font-medium" x-text="'- $' + discountAmount.toFixed(2)"></span>
                    </div>
                    <div class="flex justify-between text-sm text-slate-500">
                        <span>Tax (8%)</span>
                        <span class="price-tag font-medium text-slate-700" x-text="'$' + taxAmount.toFixed(2)"></span>
                    </div>
                    <div class="h-px bg-slate-100 my-1"></div>
                    <div class="flex justify-between items-center">
                        <span class="font-bold text-slate-800 text-base">Total</span>
                        <span class="price-tag text-xl font-bold text-brand-700" x-text="'$' + grandTotal.toFixed(2)"></span>
                    </div>
                </div>

                {{-- Checkout button --}}
                <div class="px-4 pb-5 pt-2">
                    <button
                        @click="checkout()"
                        :disabled="cartItems.length === 0 || isCheckingOut"
                        class="checkout-btn w-full text-white font-semibold py-3.5 rounded-xl flex items-center justify-center gap-2 disabled:opacity-40 disabled:cursor-not-allowed disabled:transform-none disabled:shadow-none">
                        <template x-if="isCheckingOut">
                            <svg class="spin w-4 h-4" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                            </svg>
                        </template>
                        <template x-if="!isCheckingOut">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
                            </svg>
                        </template>
                        <span x-text="isCheckingOut ? 'Processing…' : 'Charge $' + grandTotal.toFixed(2)"></span>
                    </button>

                    {{-- Payment methods row --}}
                    <!-- Payment methods row in your Cart Sidebar -->
<!-- <div x-show="cartItems.length > 0" class="flex items-center justify-center gap-3 mt-3">
    <button 
        @click="paymentMethod = 'card'"
        :class="paymentMethod === 'card' ? 'bg-brand-500 text-white' : 'text-slate-400 bg-slate-50'"
        class="text-[10px] hover:text-slate-600 flex items-center gap-1 transition-colors font-medium px-2 py-1 rounded-lg">
        Card
    </button>
    <div class="w-px h-3 bg-slate-200"></div>
    <button 
        @click="paymentMethod = 'cash'"
        :class="paymentMethod === 'cash' ? 'bg-brand-500 text-white' : 'text-slate-400 bg-slate-50'"
        class="text-[10px] hover:text-slate-600 flex items-center gap-1 transition-colors font-medium px-2 py-1 rounded-lg">
        Cash
    </button>
    <div class="w-px h-3 bg-slate-200"></div>
    <button 
        @click="paymentMethod = 'qr'"
        :class="paymentMethod === 'qr' ? 'bg-brand-500 text-white' : 'text-slate-400 bg-slate-50'"
        class="text-[10px] hover:text-slate-600 flex items-center gap-1 transition-colors font-medium px-2 py-1 rounded-lg">
        QR
    </button>
</div> -->
                </div>
            </div>
        </aside>
    </div>

    {{-- ===================================================================
     ALPINE.JS APP LOGIC
=================================================================== --}}

    <!-- <script>
    function posApp() {
        return {
            // ── State ──
            activeCategory: 'all',
            activeCategoryName: 'All Products',
            searchQuery: '',
            gridView: true,
            isLoading: false,
            isCheckingOut: false,
            showDiscount: false,
            showCheckoutSuccess: false,
            discountPercent: 0,
            orderNote: '',
            lastOrderId: '',
            lastOrderTotal: 0,
            currentTime: '',
            toasts: [],
            toastCounter: 0,

            // Data passed from PHP
            allProducts: {{ Js::from($products->map(fn($p) => ['id' => $p->id, 'name' => $p->name, 'price' => (float) $p->price, 'image' => $p->image ?? null, 'sku' => $p->sku ?? null, 'category_id' => (string) $p->category_id])->values()) }},

            categoryMap: {{ Js::from($categories->pluck('name', 'id')) }},
            cart: {{ Js::from($cart) }},
            filteredProducts: [],

            // ── Computed ──
            get cartItems() { return Object.values(this.cart); },
            get totalQty() { return this.cartItems.reduce((sum, i) => sum + i.qty, 0); },
            get cartSubtotal() { return this.cartItems.reduce((sum, i) => sum + (i.price * i.qty), 0); },
            get discountAmount() { return this.cartSubtotal * (parseFloat(this.discountPercent) || 0) / 100; },
            get taxAmount() { return (this.cartSubtotal - this.discountAmount) * 0.08; },
            get grandTotal() { return this.cartSubtotal - this.discountAmount + this.taxAmount; },

            // ── Init ──
            init() {
                // Ensure allProducts is an array before spreading
                this.filteredProducts = Array.isArray(this.allProducts) ? [...this.allProducts] : [];
                this.setActiveCategoryName();
                this.startClock();
            },

            startClock() {
                const tick = () => {
                    this.currentTime = new Date().toLocaleTimeString('en-US', {
                        hour: '2-digit', minute: '2-digit', second: '2-digit'
                    });
                };
                tick();
                setInterval(tick, 1000);
            },

            filterCategory(categoryId) {
                this.activeCategory = String(categoryId);
                this.searchQuery = '';
                this.setActiveCategoryName();
                this.applyFilters();
            },

            setActiveCategoryName() {
                this.activeCategoryName = (this.activeCategory === 'all') 
                    ? 'All Products' 
                    : (this.categoryMap[this.activeCategory] || 'Unknown');
            },

            filterProducts() { this.applyFilters(); },

            applyFilters() {
                let list = [...this.allProducts];
                if (this.activeCategory !== 'all') {
                    list = list.filter(p => String(p.category_id) === this.activeCategory);
                }
                if (this.searchQuery.trim()) {
                    const q = this.searchQuery.toLowerCase().trim();
                    list = list.filter(p => 
                        p.name.toLowerCase().includes(q) || 
                        (p.sku && p.sku.toLowerCase().includes(q))
                    );
                }
                this.filteredProducts = list;
            },

            isInCart(productId) { return !!this.cart[String(productId)]; },

            // ── Cart: frontend-first (UI updates instantly, backend syncs in background) ──

            addToCart(product) {
                const key = String(product.id);
                if (this.cart[key]) {
                    this.cart[key].qty++;
                } else {
                    this.cart = {
                        ...this.cart,
                        [key]: {
                            id:    product.id,
                            name:  product.name,
                            price: parseFloat(product.price),
                            image: product.image || null,
                            sku:   product.sku   || null,
                            qty:   1,
                        }
                    };
                }
                this.showToast(product.name + ' added');
                this.syncToBackend('add', { product_id: product.id });
            },

            updateQty(productId, action) {
                const key = String(productId);
                if (!this.cart[key]) return;
                if (action === 'increment') {
                    this.cart[key].qty++;
                } else {
                    this.cart[key].qty--;
                    if (this.cart[key].qty <= 0) {
                        const updated = { ...this.cart };
                        delete updated[key];
                        this.cart = updated;
                    }
                }
                this.syncToBackend('update', { product_id: productId, action });
            },

            removeFromCart(productId) {
                const key = String(productId);
                const name = this.cart[key] ? this.cart[key].name : 'Item';
                const updated = { ...this.cart };
                delete updated[key];
                this.cart = updated;
                this.showToast(name + ' removed');
                this.syncToBackend('remove', { product_id: productId });
            },

            clearCart() {
                this.cart = {};
                this.discountPercent = 0;
                this.orderNote = '';
                this.showToast('Cart cleared');
                this.syncToBackend('clear', {});
            },

            syncToBackend(action, payload) {
                const urls = {
                    add:    '{{ route("pos.cart.add") }}',
                    update: '{{ route("pos.cart.update") }}',
                    remove: '{{ route("pos.cart.remove") }}',
                    clear:  '{{ route("pos.cart.clear") }}',
                };
                fetch(urls[action], {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content,
                        'Accept': 'application/json',
                    },
                    body: JSON.stringify(payload),
                }).catch(() => {});
            },

            async checkout() {
                if (this.cartItems.length === 0 || this.isCheckingOut) return;
                this.isCheckingOut = true;
                try {
                    const res = await fetch('{{ route("pos.checkout") }}', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content,
                            'Accept': 'application/json',
                        },
                        body: JSON.stringify({
                            discount_percent: this.discountPercent,
                            note: this.orderNote,
                            total: this.grandTotal,
                            cart: this.cart,
                        }),
                    });
                    const data = await res.json();
                    if (data.success) {
                        this.lastOrderId    = data.order_id;
                        this.lastOrderTotal = data.total;
                        this.cart           = {};
                        this.discountPercent = 0;
                        this.orderNote      = '';
                        this.showCheckoutSuccess = true;
                    } else {
                        this.showToast(data.message || 'Checkout failed', 'error');
                    }
                } catch (e) { this.showToast('Network error', 'error'); }
                finally { this.isCheckingOut = false; }
            },

            showToast(message, type = 'success') {
                const id = ++this.toastCounter;
                this.toasts.push({ id, message, type });
                setTimeout(() => {
                    this.toasts = this.toasts.filter(t => t.id !== id);
                }, 3000);
            },
        };
    }
</script> -->

<script>
function posApp() {
    return {
        // ── State (CRITICAL: Added missing variables here) ──
        activeCategory: 'all',
        activeCategoryName: 'All Products',
        searchQuery: '',
        gridView: true,
        isLoading: false,
        isCheckingOut: false,
        showDiscount: false,
        showCheckoutSuccess: false,
        showBillingModal: false, // Define this so products show up again
        customer: {              // Define this so x-model works
            name: '',
            phone: '',
            address: '',
        },
        // New: Track amounts for each payment method
        payments: {
            cash: 0,
            card: 0,
            qr: 0
        },
        // Computed to get the sum of entered payments
        get totalPaid() {
            return (parseFloat(this.payments.cash) || 0) + 
                (parseFloat(this.payments.card) || 0) + 
                (parseFloat(this.payments.qr) || 0);
        },

        // Computed: Calculated difference (positive means underpaid, negative means change due)
        get paymentDifference() {
            return (this.grandTotal - this.totalPaid).toFixed(2);
        },

        // Computed: Boolean to check if the order is valid for submission
        get canSubmitOrder() {
            // Allows submission if exact amount is paid OR if cash provides change
            // Usually, Card and QR must be exact, but Cash can be higher
            if (parseFloat(this.paymentDifference) > 0.01) {
                return this.customer.name && this.customer.phone;
            }
            return true;

            // const isUnderpaid = (this.grandTotal - this.totalPaid) > 0.01;
            // return !isUnderpaid && this.customer.name && this.customer.phone;
        },

        // Computed to check if the full amount is covered
        get paymentRemaining() {
            return this.grandTotal - this.totalPaid;
        },

        discountPercent: 0,
        orderNote: '',
        lastOrderId: '',
        lastOrderTotal: 0,
        currentTime: '',
        toasts: [],
        toastCounter: 0,

        // Data passed from PHP
        allProducts: {{ Js::from($products->map(fn($p) => ['id' => $p->id, 'name' => $p->name, 'price' => (float) $p->price, 'image' => $p->image ?? null, 'sku' => $p->sku ?? null, 'category_id' => (string) $p->category_id])->values()) }},
        categoryMap: {{ Js::from($categories->pluck('name', 'id')) }},
        cart: {{ Js::from($cart) }},
        filteredProducts: [],

        // ── Computed ──
        get cartItems() { return Object.values(this.cart); },
        get totalQty() { return this.cartItems.reduce((sum, i) => sum + i.qty, 0); },
        get cartSubtotal() { return this.cartItems.reduce((sum, i) => sum + (i.price * i.qty), 0); },
        get discountAmount() { return this.cartSubtotal * (parseFloat(this.discountPercent) || 0) / 100; },
        get taxAmount() { return (this.cartSubtotal - this.discountAmount) * 0.08; },
        get grandTotal() { return this.cartSubtotal - this.discountAmount + this.taxAmount; },

        // ── Init ──
        init() {
            this.filteredProducts = Array.isArray(this.allProducts) ? [...this.allProducts] : [];
            this.setActiveCategoryName();
            this.startClock();
        },

        startClock() {
            const tick = () => {
                this.currentTime = new Date().toLocaleTimeString('en-US', {
                    hour: '2-digit', minute: '2-digit', second: '2-digit'
                });
            };
            tick();
            setInterval(tick, 1000);
        },

        filterCategory(categoryId) {
            this.activeCategory = String(categoryId);
            this.searchQuery = '';
            this.setActiveCategoryName();
            this.applyFilters();
        },

        setActiveCategoryName() {
            this.activeCategoryName = (this.activeCategory === 'all') 
                ? 'All Products' 
                : (this.categoryMap[this.activeCategory] || 'Unknown');
        },

        filterProducts() { this.applyFilters(); },

        applyFilters() {
            let list = [...this.allProducts];
            if (this.activeCategory !== 'all') {
                list = list.filter(p => String(p.category_id) === this.activeCategory);
            }
            if (this.searchQuery.trim()) {
                const q = this.searchQuery.toLowerCase().trim();
                list = list.filter(p => 
                    p.name.toLowerCase().includes(q) || 
                    (p.sku && p.sku.toLowerCase().includes(q))
                );
            }
            this.filteredProducts = list;
        },

        isInCart(productId) { return !!this.cart[String(productId)]; },

        addToCart(product) {
            const key = String(product.id);
            if (this.cart[key]) {
                this.cart[key].qty++;
            } else {
                this.cart = {
                    ...this.cart,
                    [key]: {
                        id: product.id,
                        name: product.name,
                        price: parseFloat(product.price),
                        image: product.image || null,
                        sku: product.sku || null,
                        qty: 1,
                    }
                };
            }
            this.showToast(product.name + ' added');
            this.syncToBackend('add', { product_id: product.id });
        },

        updateQty(productId, action) {
            const key = String(productId);
            if (!this.cart[key]) return;
            if (action === 'increment') {
                this.cart[key].qty++;
            } else {
                this.cart[key].qty--;
                if (this.cart[key].qty <= 0) {
                    const updated = { ...this.cart };
                    delete updated[key];
                    this.cart = updated;
                }
            }
            this.syncToBackend('update', { product_id: productId, action });
        },

        removeFromCart(productId) {
            const key = String(productId);
            const name = this.cart[key] ? this.cart[key].name : 'Item';
            const updated = { ...this.cart };
            delete updated[key];
            this.cart = updated;
            this.showToast(name + ' removed');
            this.syncToBackend('remove', { product_id: productId });
        },

        clearCart() {
            this.cart = {};
            this.discountPercent = 0;
            this.orderNote = '';
            this.showToast('Cart cleared');
            this.syncToBackend('clear', {});
        },

        syncToBackend(action, payload) {
            const urls = {
                add: '{{ route("pos.cart.add") }}',
                update: '{{ route("pos.cart.update") }}',
                remove: '{{ route("pos.cart.remove") }}',
                clear: '{{ route("pos.cart.clear") }}',
            };
            fetch(urls[action], {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content,
                    'Accept': 'application/json',
                },
                body: JSON.stringify(payload),
            }).catch(() => {});
        },

        // STEP 1: Show Popup instead of charging
        checkout() {
            if (this.cartItems.length === 0) {
                this.showToast('Your cart is empty!', 'error');
                return;
            }
            this.showBillingModal = true;
        },
async confirmOrder() {
    if (!this.customer.name || !this.customer.phone) {
        this.showToast('Name and Phone are required', 'error');
        return;
    }
    
    this.isCheckingOut = true;

    try {
        const res = await fetch('{{ route("pos.checkout") }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content,
                'Accept': 'application/json',
            },
            body: JSON.stringify({
                discount_percent: this.discountPercent,
                note: this.orderNote,
                total: this.grandTotal,
                cart: this.cart, // Passing the full cart object to Controller
                customer_name: this.customer.name,
                customer_phone: this.customer.phone,
                billing_address: this.customer.address,
                payment_details: this.payments
            }),
        });

        const data = await res.json();
        
        if (data.success) {
            // Store receipt data before clearing the active cart
            this.lastOrderId = data.order_id;
            this.lastOrderTotal = data.total;
            this.lastOrderItems = [...this.cartItems]; // Snapshot for the bill
            
            // Success Actions
            this.showBillingModal = false;
            this.showCheckoutSuccess = true;
            
            // Clear active cart for next transaction
            this.cart = {};
            this.customer = { name: '', phone: '', address: '' };
            this.payments = { cash: 0, card: 0, qr: 0 };
            this.discountPercent = 0;
            this.orderNote = '';
        } else {
            this.showToast(data.message || 'Checkout failed', 'error');
        }
    } catch (e) {
        this.showToast('Network error', 'error');
    } finally {
        this.isCheckingOut = false;
    }
},

        showToast(message, type = 'success') {
            const id = ++this.toastCounter;
            this.toasts.push({ id, message, type });
            setTimeout(() => {
                this.toasts = this.toasts.filter(t => t.id !== id);
            }, 3000);
        },
    };
}
</script>

<!-- Items Table in Receipt -->
<table style="width: 100%; border-collapse: collapse; margin-bottom: 10px;">
    <thead>
        <tr style="border-bottom: 1px solid #000;">
            <th style="text-align: left;">Item</th>
            <th style="text-align: center;">Qty</th>
            <th style="text-align: right;">Price</th>
        </tr>
    </thead>
    <tbody>
        <!-- Use lastOrderItems so the bill stays populated after cart is cleared -->
        <template x-for="item in lastOrderItems" :key="item.id">
            <tr>
                <td x-text="item.name"></td>
                <td style="text-align: center;" x-text="item.qty"></td>
                <td style="text-align: right;" x-text="(item.price * item.qty).toFixed(2)"></td>
            </tr>
        </template>
    </tbody>
</table>

<!-- Customer Details Modal --><!-- Customer & Payment Details Modal -->
<div x-show="showBillingModal" 
     class="fixed inset-0 z-[60] flex items-center justify-center bg-slate-900/50 backdrop-blur-sm"
     x-cloak x-transition>
    <div class="bg-white rounded-[2rem] shadow-2xl max-w-3xl w-full mx-4 overflow-hidden border border-slate-100">
        
        <!-- Header Section -->
        <div class="px-8 py-6 border-b border-slate-50 flex justify-between items-end bg-white">
            <div>
                <h2 class="text-2xl font-bold text-slate-800 tracking-tight">Finalize Transaction</h2>
                <p class="text-xs text-slate-400 font-medium mt-1">Please verify customer details and payment breakdown</p>
            </div>
            <div class="text-right">
                <p class="text-[10px] text-brand-500 uppercase font-bold tracking-[0.1em] mb-1">Grand Total</p>
                <p class="text-3xl font-black text-brand-600 price-tag" x-text="'$' + grandTotal.toFixed(2)"></p>
            </div>
        </div>

        <div class="p-8 bg-white">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
                
                <!-- Left Column: Customer Information -->
                <div class="flex flex-col h-full">
                    <div class="flex items-center gap-2 mb-6">
                        <div class="w-8 h-8 rounded-lg bg-brand-50 flex items-center justify-center text-brand-600">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                        </div>
                        <h3 class="text-sm font-bold text-slate-700 uppercase tracking-wide">Customer Information</h3>
                    </div>

                    <div class="space-y-4 flex-1">
                        <div class="space-y-1.5">
                            <label class="text-[11px] font-bold text-slate-400 ml-1 uppercase">Full Name</label>
                            <input type="text" x-model="customer.name" placeholder="e.g. Manjunath Bhasker" 
                                   class="w-full px-4 py-3.5 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-brand-500/10 focus:border-brand-500 outline-none text-sm transition-all placeholder:text-slate-300">
                        </div>
                        <div class="space-y-1.5">
                            <label class="text-[11px] font-bold text-slate-400 ml-1 uppercase">Contact Number</label>
                            <input type="text" x-model="customer.phone" placeholder="e.g. 08129161710" 
                                   class="w-full px-4 py-3.5 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-brand-500/10 focus:border-brand-500 outline-none text-sm transition-all placeholder:text-slate-300">
                        </div>
                        <div class="space-y-1.5 flex-1">
                            <label class="text-[11px] font-bold text-slate-400 ml-1 uppercase">Billing Address</label>
                            <textarea x-model="customer.address" rows="4" placeholder="Street, City, Landmark..." 
                                      class="w-full px-4 py-3.5 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-brand-500/10 focus:border-brand-500 outline-none text-sm transition-all resize-none placeholder:text-slate-300"></textarea>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Payment Methods -->
                <div class="flex flex-col h-full border-l border-slate-50 pl-2">
                    <div class="flex items-center gap-2 mb-6 pl-4">
                        <div class="w-8 h-8 rounded-lg bg-emerald-50 flex items-center justify-center text-emerald-600">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
                        </div>
                        <h3 class="text-sm font-bold text-slate-700 uppercase tracking-wide">Payment Methods</h3>
                    </div>

                    <div class="space-y-5 pl-4 flex-1">
                        <!-- Cash -->
                        <div class="relative group">
                            <label class="absolute -top-2 left-3 px-2 bg-white text-[10px] font-black text-slate-400 z-10 group-focus-within:text-brand-600 transition-colors">CASH PAYMENT</label>
                            <div class="relative">
                                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-300 font-bold text-lg">$</span>
                                <input type="number" x-model="payments.cash" step="0.01" 
                                       class="w-full pl-9 pr-4 py-4 bg-white border-2 border-slate-100 rounded-2xl focus:border-brand-500 focus:bg-white outline-none font-mono font-bold text-lg text-slate-700 transition-all shadow-sm">
                            </div>
                        </div>

                        <!-- Card -->
                        <div class="relative group">
                            <label class="absolute -top-2 left-3 px-2 bg-white text-[10px] font-black text-slate-400 z-10 group-focus-within:text-brand-600 transition-colors">CARD PAYMENT</label>
                            <div class="relative">
                                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-300 font-bold text-lg">$</span>
                                <input type="number" x-model="payments.card" step="0.01" 
                                       class="w-full pl-9 pr-4 py-4 bg-white border-2 border-slate-100 rounded-2xl focus:border-brand-500 focus:bg-white outline-none font-mono font-bold text-lg text-slate-700 transition-all shadow-sm">
                            </div>
                        </div>

                        <!-- QR -->
                        <div class="relative group">
                            <label class="absolute -top-2 left-3 px-2 bg-white text-[10px] font-black text-slate-400 z-10 group-focus-within:text-brand-600 transition-colors">QR / DIGITAL</label>
                            <div class="relative">
                                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-300 font-bold text-lg">$</span>
                                <input type="number" x-model="payments.qr" step="0.01" 
                                       class="w-full pl-9 pr-4 py-4 bg-white border-2 border-slate-100 rounded-2xl focus:border-brand-500 focus:bg-white outline-none font-mono font-bold text-lg text-slate-700 transition-all shadow-sm">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Action Section / Status Bar -->
        <div class="px-8 pb-8 pt-4 bg-white">
            <!-- Amount Status Indicator -->
            <!-- <div class="flex items-center justify-between px-6 py-4 rounded-[1.25rem] mb-6 transition-all duration-300" 
                 :class="paymentDifference > 0 ? 'bg-red-50 border border-red-100' : 'bg-emerald-50 border border-emerald-100'">
                <div class="flex items-center gap-3">
                    <div class="w-2.5 h-2.5 rounded-full" :class="paymentDifference > 0 ? 'bg-red-500 animate-pulse' : 'bg-emerald-500'"></div>
                    <div>
                        <p class="text-[10px] font-black uppercase tracking-widest leading-none" 
                           :class="paymentDifference > 0 ? 'text-red-400' : 'text-emerald-400'"
                           x-text="paymentDifference > 0 ? 'Payment Incomplete' : 'Balance Status'"></p>
                        <p class="text-sm font-bold mt-1" 
                           :class="paymentDifference > 0 ? 'text-red-700' : 'text-emerald-700'"
                           x-text="paymentDifference > 0 ? 'Collect remaining amount' : 'Ready to checkout'"></p>
                    </div>
                </div>
                <div class="text-right">
                    <p class="text-[10px] font-bold uppercase opacity-60" :class="paymentDifference > 0 ? 'text-red-700' : 'text-emerald-700'" x-text="paymentDifference > 0 ? 'Remaining' : 'Change'"></p>
                    <p class="text-2xl font-black font-mono leading-none mt-1" :class="paymentDifference > 0 ? 'text-red-700' : 'text-emerald-700'" x-text="'$' + Math.abs(paymentDifference).toFixed(2)"></p>
                </div>
            </div> -->

<div class="flex items-center justify-between px-6 py-4 rounded-[1.25rem] mb-6 transition-all duration-300" 
     :class="paymentDifference > 0 ? 'bg-red-50 border-red-100' : 'bg-emerald-50 border-emerald-100'">
    <div class="flex items-center gap-3">
        <div class="w-2.5 h-2.5 rounded-full" :class="paymentDifference > 0 ? 'bg-red-500 animate-pulse' : 'bg-emerald-500'"></div>
        <div>
            <p class="text-[10px] font-black uppercase tracking-widest leading-none" 
               :class="paymentDifference > 0 ? 'text-red-400' : 'text-emerald-400'"
               x-text="paymentDifference > 0 ? 'Balance to Store' : 'Payment Status'"></p>
            <p class="text-sm font-bold mt-1" 
               :class="paymentDifference > 0 ? 'text-red-700' : 'text-emerald-700'"
               x-text="paymentDifference > 0 ? 'Remaining will be saved to credit' : 'Ready to checkout'"></p>
        </div>
    </div>
    <div class="text-right">
        <p class="text-[10px] font-bold uppercase opacity-60" 
           :class="paymentDifference > 0 ? 'text-red-700' : 'text-emerald-700'" 
           x-text="paymentDifference > 0 ? 'Remaining' : 'Change Due'"></p>
        <p class="text-2xl font-black font-mono leading-none mt-1" 
           :class="paymentDifference > 0 ? 'text-red-700' : 'text-emerald-700'" 
           x-text="'$' + Math.abs(paymentDifference).toFixed(2)"></p>
    </div>
</div>

            <!-- Main Buttons -->
            <div class="flex gap-4">
                <button @click="showBillingModal = false" 
                        class="px-8 py-4 bg-slate-50 text-slate-500 font-bold rounded-2xl hover:bg-slate-100 hover:text-slate-700 transition-all">
                    Cancel
                </button>
                <button @click="confirmOrder()" 
                        :disabled="!canSubmitOrder || isCheckingOut"
                        class="flex-1 checkout-btn text-white font-bold text-lg rounded-2xl disabled:opacity-40 disabled:grayscale transition-all flex items-center justify-center gap-3 py-4">
                    <span x-show="!isCheckingOut">Confirm & Print Receipt</span>
                    <svg x-show="isCheckingOut" class="spin w-6 h-6" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                </button>
            </div>
        </div>
    </div>
</div>


<!-- POS Receipt Container -->
<div style="width: 80mm; font-family: 'DM Mono', monospace; font-size: 12px; line-height: 1.4; color: #000; padding: 10px; background: #fff;">
    
    <!-- Header -->
    <div style="text-align: center; margin-bottom: 10px;">
        <h2 style="margin: 0; font-size: 16px; text-transform: uppercase;">{{ config('app.name') }}</h2>
        <p style="margin: 2px 0;">123 Supermarket St, Retail City</p>
        <p style="margin: 2px 0;">Tel: +1 234 567 890</p>
        <p style="margin: 5px 0; border-top: 1px dashed #000; border-bottom: 1px dashed #000; padding: 3px 0;">
            RECEIPT: #<span x-text="lastOrderId"></span>
        </p>
    </div>

    <!-- Info Section -->
    <div style="margin-bottom: 10px;">
        <p style="margin: 0;">Date: {{ now()->format('d/m/Y H:i') }}</p>
        <p style="margin: 0;">Cashier: {{ auth()->user()->name ?? 'Admin' }}</p>
        <template x-if="customer.name">
            <p style="margin: 0;">Cust: <span x-text="customer.name"></span></p>
        </template>
    </div>

    <!-- Items Table -->
    <table style="width: 100%; border-collapse: collapse; margin-bottom: 10px;">
        <thead>
            <tr style="border-bottom: 1px solid #000;">
                <th style="text-align: left; padding: 5px 0;">Item</th>
                <th style="text-align: center;">Qty</th>
                <th style="text-align: right;">Price</th>
            </tr>
        </thead>
        <tbody>
            <template x-for="item in cartItems" :key="item.id">
                <tr>
                    <td style="padding: 5px 0;">
                        <span x-text="item.name"></span><br>
                        <small x-text="'SKU: ' + (item.sku || 'N/A')" style="font-size: 10px;"></small>
                    </td>
                    <td style="text-align: center;" x-text="item.qty"></td>
                    <td style="text-align: right;" x-text="(item.price * item.qty).toFixed(2)"></td>
                </tr>
            </template>
        </tbody>
    </table>

    <!-- Totals -->
    <div style="border-top: 1px dashed #000; padding-top: 5px;">
        <div style="display: flex; justify-content: space-between;">
            <span>Subtotal:</span>
            <span x-text="cartSubtotal.toFixed(2)"></span>
        </div>
        <template x-if="discountAmount > 0">
            <div style="display: flex; justify-content: space-between;">
                <span x-text="'Discount (' + discountPercent + '%):'"></span>
                <span x-text="'-' + discountAmount.toFixed(2)"></span>
            </div>
        </template>
        <div style="display: flex; justify-content: space-between;">
            <span>Tax (8%):</span>
            <span x-text="taxAmount.toFixed(2)"></span>
        </div>
        <div style="display: flex; justify-content: space-between; font-weight: bold; font-size: 14px; margin-top: 5px;">
            <span>GRAND TOTAL:</span>
            <span x-text="'$' + grandTotal.toFixed(2)"></span>
        </div>
    </div>

    <!-- Payment Breakdown -->
    <div style="margin-top: 10px; font-size: 11px;">
        <p style="margin: 0; font-weight: bold;">PAID BY:</p>
        <template x-if="payments.cash > 0">
            <div style="display: flex; justify-content: space-between;">
                <span>Cash:</span>
                <span x-text="parseFloat(payments.cash).toFixed(2)"></span>
            </div>
        </template>
        <template x-if="payments.card > 0">
            <div style="display: flex; justify-content: space-between;">
                <span>Card:</span>
                <span x-text="parseFloat(payments.card).toFixed(2)"></span>
            </div>
        </template>
        <template x-if="payments.qr > 0">
            <div style="display: flex; justify-content: space-between;">
                <span>QR/Digital:</span>
                <span x-text="parseFloat(payments.qr).toFixed(2)"></span>
            </div>
        </template>
        <template x-if="parseFloat(paymentDifference) < 0">
            <div style="display: flex; justify-content: space-between; font-weight: bold; margin-top: 3px;">
                <span>CHANGE DUE:</span>
                <span x-text="'$' + Math.abs(paymentDifference).toFixed(2)"></span>
            </div>
        </template>
    </div>

    <!-- Footer -->
    <div style="text-align: center; margin-top: 20px; font-size: 10px;">
        <p style="margin: 0;">THANK YOU FOR SHOPPING WITH US!</p>
        <p style="margin: 0;">Please keep this receipt for returns.</p>
        <div style="margin-top: 10px;">
            <!-- Simple Barcode Placeholder -->
            <div style="height: 30px; background: #eee; border: 1px solid #ddd; display: flex; items-center; justify-content: center;">
                <span x-text="lastOrderId"></span>
            </div>
        </div>
    </div>
</div>

</body>

</html>